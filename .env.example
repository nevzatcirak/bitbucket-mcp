# Bitbucket base URL, without a trailing slash.
# Server/DC:  https://bitbucket.example.com
# Cloud:      https://bitbucket.example.com (gateway or reverse-proxied API base)
BITBUCKET_URL=https://bitbucket.example.com

# Which deployment flavor to talk to: "server" (Server / Data Center) or "cloud".
# The Cloud adapter is not implemented yet; "cloud" starts the server but
# cloud-only tools return a structured PROVIDER_UNAVAILABLE error.
BITBUCKET_PROVIDER=server

# --- Authentication (either option A or option B is required) ---
# Option A: token auth. Server/DC personal access token -> Authorization: Bearer.
#           Cloud API token (used together with BITBUCKET_USERNAME) -> Basic.
# BITBUCKET_TOKEN=

# Option B: username + password / token pair -> Authorization: Basic.
# BITBUCKET_USERNAME=
# BITBUCKET_PASSWORD=

# When "true", write tools are not advertised at all (read-only deployments).
BITBUCKET_READ_ONLY=false

# Extra HTTP headers appended to every request.
# Comma-separated "Name: Value" pairs, e.g. "X-Custom-Trace: abc123, X-Tenant: t1"
BITBUCKET_CUSTOM_HEADERS=
